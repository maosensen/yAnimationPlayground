# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
**/.next/
**/out/

# production
**/build/
**/dist/
**/output/

# generated video production assets
packages/video-contract/generated/
apps/remotion/public/*.wav
apps/hyperframes/assets/
apps/hyperframes/vendor/
