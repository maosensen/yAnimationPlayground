{
  "name": "yanimation-playground",
  "description": "A pnpm monorepo for browser animation and code-driven video experiments.",
  "version": "0.1.4",
  "private": true,
  "homepage": "https://github.com/maosensen/yAnimationPlayground#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maosensen/yAnimationPlayground.git"
  },
  "bugs": {
    "url": "https://github.com/maosensen/yAnimationPlayground/issues"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @yanimation/web dev",
    "build": "pnpm --filter @yanimation/web build",
    "start": "pnpm --filter @yanimation/web start",
    "check": "pnpm lint && pnpm check-types",
    "check-types": "pnpm --recursive --if-present check-types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0"
  }
}
